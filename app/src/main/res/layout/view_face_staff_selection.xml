<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/enrollment_selection"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/dp_0"
    tools:theme="@style/AppPreviewTheme">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/enrollment_search"
            style="@style/PenInput"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:background="@drawable/mc_list_search_field"
            android:hint="@string/face_enrollment_staff_search"
            android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="@dimen/dp_4"
            android:paddingEnd="@dimen/dp_4" />

        <TextView
            android:id="@+id/enrollment_search_clear"
            style="@style/PenButton"
            android:layout_width="@dimen/dp_26"
            android:layout_marginStart="@dimen/dp_4"
            android:contentDescription="@string/ui_view_face_staff_selection_enrollment_search_clear_contentdescription"
            android:paddingStart="@dimen/dp_0"
            android:paddingEnd="@dimen/dp_0"
            android:text="×" />
    </LinearLayout>

    <TextView
        style="@style/PenCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_2"
        android:layout_marginTop="@dimen/dp_4"
        android:text="@string/ui_view_face_staff_selection_label_text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/enrollment_staff_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_face_employee" />

        <TextView
            android:id="@+id/enrollment_empty"
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="5"
            android:text="@string/face_enrollment_staff_empty"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="@dimen/dp_2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/enrollment_previous"
            style="@style/PenButton"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/business_page_previous"
            android:visibility="gone" />

        <TextView
            android:id="@+id/enrollment_page_info"
            style="@style/PenCaption"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:paddingStart="@dimen/dp_2"
            android:paddingEnd="@dimen/dp_2"
            android:text="@string/business_page_loading"
            android:visibility="gone" />

        <TextView
            android:id="@+id/enrollment_next"
            style="@style/PenCaption"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/ui_view_face_staff_selection_enrollment_next_text" />
    </LinearLayout>
</LinearLayout>
