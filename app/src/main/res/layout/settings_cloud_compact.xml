<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".BusinessCloudSettingsActivity"
    tools:theme="@style/AppPreviewTheme">

    <LinearLayout
        style="@style/McBusinessControlRow"
        android:layout_width="match_parent"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/settings_edit_cloud_url"
            style="@style/McSettingsButton"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:text="@string/settings_edit_cloud_url_button" />

        <TextView
            android:id="@+id/settings_edit_cloud_token"
            style="@style/McSettingsButton"
            android:layout_width="@dimen/dp_0"
            android:layout_marginStart="@dimen/dp_5"
            android:layout_weight="1"
            android:text="@string/settings_edit_cloud_token_button" />
    </LinearLayout>

    <Space
        android:layout_width="@dimen/dp_0_5"
        android:layout_height="@dimen/dp_4" />
</LinearLayout>