<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/check_person"
        style="@style/PenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/check_person_detail"
        style="@style/PenCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2" />

    <TextView
        android:id="@+id/check_temperature"
        style="@style/PenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10" />

    <TextView
        android:id="@+id/check_prompt_label"
        style="@style/PenCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10" />

    <TextView
        android:id="@+id/check_hint"
        style="@style/PenText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5"
        android:padding="@dimen/dp_8" />

    <LinearLayout
        android:id="@+id/check_ready_devices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20"
            android:gravity="center_vertical">

            <TextView
                style="@style/PenCaption"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_view_camera_design_tabs_settings_preview_face_text" />

            <TextView
                style="@style/PenCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_view_check_current_info_label_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20"
            android:gravity="center_vertical">

            <TextView
                style="@style/PenCaption"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_view_camera_design_tabs_settings_preview_hand_text" />

            <TextView
                style="@style/PenCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_view_check_current_info_label_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20"
            android:gravity="center_vertical">

            <TextView
                style="@style/PenCaption"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_view_check_current_info_label_text_2" />

            <TextView
                style="@style/PenCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_view_check_current_info_label_text" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
