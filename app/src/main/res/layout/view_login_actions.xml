<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/McLoginPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/login_progress"
            style="@style/McLoginProgress"
            android:layout_marginEnd="@dimen/dp_6"
            android:visibility="gone" />

        <TextView
            android:id="@+id/login_status_title"
            style="@style/McLoginTitle"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/login_scan_title"
            android:textColor="#202C44" />
    </LinearLayout>

    <TextView
        android:id="@+id/login_status_message"
        style="@style/McLoginHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:accessibilityLiveRegion="polite"
        android:lineSpacingExtra="@dimen/dp_3"
        android:text="@string/login_scan_hint"
        android:textColor="#637187" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/login_choose_camera"
            style="@style/LoginAction"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:text="@string/login_choose_camera" />

        <TextView
            android:id="@+id/login_retry"
            style="@style/LoginAction"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:background="@drawable/login_primary_action"
            android:text="@string/login_retry_scan"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/login_permission_settings"
            style="@style/LoginAction"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:text="@string/login_permission_settings"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>