<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PenPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:importantForAccessibility="no"
        android:src="@drawable/mc_home_light" />

    <TextView
        style="@style/PenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/ui_view_lighting_test_label_text" />

    <TextView
        style="@style/PenText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:text="@string/ui_view_lighting_test_label_text_2" />

    <TextView
        android:id="@+id/lighting_test_on"
        style="@style/PenPrimary"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/ui_view_lighting_test_lighting_test_on_text" />

    <TextView
        android:id="@+id/lighting_test_off"
        style="@style/PenButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/dp_6"
        android:text="@string/ui_view_lighting_test_lighting_test_off_text" />

    <Space
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1" />
</LinearLayout>
