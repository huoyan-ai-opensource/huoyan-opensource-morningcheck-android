<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PenPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/PenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="测温配置" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:gravity="center_vertical"
        android:minHeight="@dimen/dp_26">

        <TextView
            style="@style/PenText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_temperature_measurement_mode" />

        <TextView
            android:id="@+id/settings_temperature_measurement_mode"
            style="@style/PenInput"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:gravity="end|center_vertical"
            android:text="@string/settings_temperature_mode_trigger" />

        <TextView
            style="@style/PenCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:gravity="center_vertical"
        android:minHeight="@dimen/dp_26">

        <TextView
            style="@style/PenText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_temperature_read_mode" />

        <cc.huoyan.opensource.morningcheck.ChoiceSpinner
            android:id="@+id/settings_temperature_mode"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:prompt="@string/choice_temperature_mode"
            android:spinnerMode="dialog" />

        <TextView
            style="@style/PenCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:gravity="center_vertical"
        android:minHeight="@dimen/dp_26">

        <TextView
            style="@style/PenText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="串口路径" />

        <TextView
            android:id="@+id/settings_serial_path"
            style="@style/PenInput"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:gravity="end|center_vertical" />

        <TextView
            style="@style/PenCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:gravity="center_vertical"
        android:minHeight="@dimen/dp_26">

        <TextView
            style="@style/PenText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="波特率" />

        <TextView
            android:id="@+id/settings_baud"
            style="@style/PenInput"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:gravity="end|center_vertical" />

        <TextView
            style="@style/PenCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›" />
    </LinearLayout>
</LinearLayout>
