<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/check_hand_guide"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/dp_24"
    android:visibility="gone">

    <ImageView
        android:id="@+id/check_hand_guide_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/check_hand_guide_caption"
        style="@style/McInspectionCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:background="@drawable/mc_check_preview"
        android:gravity="center"
        android:padding="@dimen/dp_6"
        android:textColor="@color/mc_muted" />
</LinearLayout>
