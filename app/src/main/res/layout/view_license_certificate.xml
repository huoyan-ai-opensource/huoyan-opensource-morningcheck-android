<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PenPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/PenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_view_license_certificate_label_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30"
        android:gravity="center_vertical">

        <TextView
            style="@style/PenText"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_view_license_certificate_label_text_2" />

        <TextView
            android:id="@+id/settings_license_state"
            style="@style/PenCaption"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="end"
            android:maxLines="2"
            android:textIsSelectable="true" />
    </LinearLayout>

    <include
        layout="@layout/view_license_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ListView
        android:id="@+id/settings_license_fields"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:divider="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/settings_switch_model"
            style="@style/PenButton"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:text="@string/ui_view_license_certificate_settings_switch_model_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/settings_activate"
            style="@style/PenPrimary"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:text="@string/ui_view_license_certificate_settings_activate_text" />
    </LinearLayout>
</LinearLayout>
