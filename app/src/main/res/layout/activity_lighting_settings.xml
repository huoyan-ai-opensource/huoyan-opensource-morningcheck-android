<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include layout="@layout/view_app_header" />

    <LinearLayout
        android:id="@+id/page_content"
        style="@style/PenPage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:orientation="vertical">

        <include
            layout="@layout/view_lighting_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <include
                layout="@layout/view_lighting_configuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0" />

            <include
                layout="@layout/view_lighting_test"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/view_lighting_actions" />
</LinearLayout>