<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/enrollment_staff_summary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_8"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/dp_8"
    android:paddingEnd="@dimen/dp_8">

    <TextView
        style="@style/PenCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="@dimen/dp_14"
        android:paddingVertical="@dimen/dp_4"
        android:text="当前人员："
        android:textColor="@color/BLACK"
        android:textSize="@dimen/sp_8" />

    <TextView
        android:id="@+id/enrollment_staff_name"
        style="@style/PenText"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_4"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/sp_7" />

    <TextView
        android:id="@+id/enrollment_choose_staff"
        style="@style/PenButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:minHeight="@dimen/dp_0"
        android:paddingHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_5"
        android:text="切换人员"
        android:textSize="@dimen/sp_8" />
</LinearLayout>
