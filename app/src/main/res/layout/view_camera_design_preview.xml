<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PenPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/PenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_view_camera_design_preview_label_text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_weight="1"
        android:background="@drawable/mc_preview"
        android:clipToOutline="true">

        <TextureView
            android:id="@+id/settings_camera_texture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/ui_view_camera_design_preview_settings_camera_texture_contentdescription" />

        <cc.huoyan.opensource.morningcheck.CameraCropView
            android:id="@+id/settings_camera_crop"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/settings_camera_preview_message"
            style="@style/PenText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/dp_12"
            android:text="@string/ui_view_camera_design_preview_settings_camera_preview_message_text"
            android:textColor="@color/mc_white" />
    </FrameLayout>

    <TextView
        android:id="@+id/settings_camera_preview_label"
        style="@style/PenCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:ellipsize="end"
        android:maxLines="2" />
</LinearLayout>
