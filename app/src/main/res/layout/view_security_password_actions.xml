<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/security_password_section_gap"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <Button
        android:id="@android:id/button2"
        style="@style/SecurityPasswordButton"
        android:layout_width="@dimen/security_password_zero"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/security_password_cancel" />

    <Button
        android:id="@android:id/button1"
        style="@style/SecurityPasswordButton.Primary"
        android:layout_width="@dimen/security_password_zero"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/security_password_key_gap"
        android:layout_weight="1"
        android:text="@string/security_password_save" />
</LinearLayout>
