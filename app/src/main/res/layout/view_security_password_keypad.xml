<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        style="@style/SecurityPasswordKeyRow">

        <Button
            android:id="@+id/security_password_key_1"
            style="@style/SecurityPasswordKey"
            android:text="1" />

        <Button
            android:id="@+id/security_password_key_2"
            style="@style/SecurityPasswordKey.Middle"
            android:text="2" />

        <Button
            android:id="@+id/security_password_key_3"
            style="@style/SecurityPasswordKey"
            android:text="3" />
    </LinearLayout>

    <LinearLayout
        style="@style/SecurityPasswordKeyRow.Spaced">

        <Button
            android:id="@+id/security_password_key_4"
            style="@style/SecurityPasswordKey"
            android:text="4" />

        <Button
            android:id="@+id/security_password_key_5"
            style="@style/SecurityPasswordKey.Middle"
            android:text="5" />

        <Button
            android:id="@+id/security_password_key_6"
            style="@style/SecurityPasswordKey"
            android:text="6" />
    </LinearLayout>

    <LinearLayout
        style="@style/SecurityPasswordKeyRow.Spaced">

        <Button
            android:id="@+id/security_password_key_7"
            style="@style/SecurityPasswordKey"
            android:text="7" />

        <Button
            android:id="@+id/security_password_key_8"
            style="@style/SecurityPasswordKey.Middle"
            android:text="8" />

        <Button
            android:id="@+id/security_password_key_9"
            style="@style/SecurityPasswordKey"
            android:text="9" />
    </LinearLayout>

    <LinearLayout
        style="@style/SecurityPasswordKeyRow.Spaced">

        <Button
            android:id="@+id/security_password_key_clear"
            style="@style/SecurityPasswordKey.Action"
            android:text="@string/security_password_clear" />

        <Button
            android:id="@+id/security_password_key_0"
            style="@style/SecurityPasswordKey.Middle"
            android:text="0" />

        <Button
            android:id="@+id/security_password_key_delete"
            style="@style/SecurityPasswordKey.Action"
            android:text="@string/security_password_delete" />
    </LinearLayout>
</LinearLayout>
