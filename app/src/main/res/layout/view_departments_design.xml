<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg"
    android:orientation="vertical">

    <include layout="@layout/view_app_header" />

    <LinearLayout
        android:id="@+id/page_content"
        style="@style/PenPage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            style="@style/PenPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_26"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/department_search"
                    style="@style/PenInput"
                    android:layout_width="@dimen/dp_0"
                    android:layout_weight="1"
                    android:hint="搜索部门名称"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/department_clear"
                    style="@style/PenButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/dp_6"
                    android:text="不分配部门"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/department_add"
                    style="@style/PenPrimary"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/dp_6"
                    android:text="新增部门" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/department_table_content"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_6"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/department_table_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/mc_list_table_header"
                    android:baselineAligned="false"
                    android:minHeight="@dimen/dp_24"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dp_8"
                    android:paddingEnd="@dimen/dp_8">

                    <TextView
                        style="@style/PenHeaderCell"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:paddingStart="@dimen/dp_18"
                        android:paddingEnd="@dimen/dp_8"
                        android:text="部门名称"
                        android:textAlignment="gravity" />

                    <TextView
                        style="@style/PenHeaderCell"
                        android:layout_width="@dimen/dp_40"
                        android:layout_weight="0"
                        android:gravity="center"
                        android:text="人数" />

                    <TextView
                        android:id="@+id/department_title_actions"
                        style="@style/PenHeaderCell"
                        android:layout_width="@dimen/dp_90"
                        android:layout_weight="0"
                        android:gravity="center"
                        android:text="操作" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_0"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/department_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:scrollbars="vertical" />

                    <TextView
                        android:id="@+id/department_empty"
                        style="@style/PenCaption"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/department_end"
                style="@style/PenCaption"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_24"
                android:gravity="center" />

            <TextView
                android:id="@+id/department_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/department_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
