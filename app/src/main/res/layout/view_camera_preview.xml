<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mc_preview"
    android:clipToOutline="true"
    tools:context=".CheckActivity"
    tools:theme="@style/AppPreviewTheme">

    <TextureView
        android:id="@+id/camera_texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <cc.huoyan.opensource.morningcheck.DetectionOverlay
        android:id="@+id/camera_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/camera_preview_caption"
        style="@style/McPreviewCaption"
        android:layout_width="match_parent"
        android:background="@drawable/mc_preview_caption"
        android:text="@string/mc_preview_hint"
        android:textColor="@color/mc_white" />
</FrameLayout>
