<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_12">

    <TextView
        style="@style/McHealthDateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_view_health_date_summary_label_text" />

    <TextView
        android:id="@+id/health_date_selected"
        style="@style/McHealthDateSelected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="2026-10-10" />

    <TextView
        android:id="@+id/health_date_weekday"
        style="@style/McHealthDateLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="@string/ui_view_health_date_summary_health_date_weekday_text" />
</LinearLayout>
