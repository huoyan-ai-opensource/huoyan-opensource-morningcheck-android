<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photo_fullscreen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <cc.huoyan.opensource.morningcheck.PhotoViewerImageView
        android:id="@+id/photo_fullscreen_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/ui_dialog_record_photo_fullscreen_photo_fullscreen_image_contentdescription" />

    <TextView
        android:id="@+id/photo_fullscreen_position"
        style="@style/PenCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/dp_12"
        android:background="#66000000"
        android:paddingStart="@dimen/dp_8"
        android:paddingTop="@dimen/dp_4"
        android:paddingEnd="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_4"
        android:textColor="@color/mc_white" />
</FrameLayout>
