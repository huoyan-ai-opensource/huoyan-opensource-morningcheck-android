<?xml version="1.0" encoding="utf-8"?>
<LinearLayout style="@style/ChoiceRow"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/department_filter_option_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mc_choice_row"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/dp_8"
    android:paddingTop="@dimen/dp_4"
    android:paddingEnd="@dimen/dp_8"
    android:paddingBottom="@dimen/dp_4">

    <TextView
        android:id="@+id/department_filter_option_name"
        style="@style/PenText"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/sp_8" />

    <TextView
        android:id="@+id/department_filter_option_selected"
        style="@style/PenText"
        android:layout_width="@dimen/dp_10"
        android:layout_height="@dimen/dp_10"
        android:layout_marginStart="@dimen/dp_6"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:textSize="@dimen/sp_5" />
</LinearLayout>
