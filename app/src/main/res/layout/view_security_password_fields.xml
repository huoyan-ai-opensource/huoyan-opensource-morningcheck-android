<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:saveEnabled="false">

    <TextView
        android:id="@+id/security_password_original_label"
        style="@style/SecurityPasswordLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/security_password_original"
        android:text="@string/security_password_original" />

    <cc.huoyan.opensource.morningcheck.SecurityPasswordEditText
        android:id="@+id/security_password_original"
        style="@style/SecurityPasswordInput"
        android:layout_width="match_parent"
        android:layout_height="@dimen/security_password_input_height"
        android:layout_marginTop="@dimen/security_password_field_gap"
        android:hint="@string/security_password_input_hint" />

    <LinearLayout
        android:id="@+id/security_password_new_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/security_password_group_gap"
        android:orientation="vertical">

        <TextView
            style="@style/SecurityPasswordLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/security_password_new"
            android:text="@string/security_password_new" />

        <cc.huoyan.opensource.morningcheck.SecurityPasswordEditText
            android:id="@+id/security_password_new"
            style="@style/SecurityPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/security_password_input_height"
            android:layout_marginTop="@dimen/security_password_field_gap"
            android:hint="@string/security_password_input_hint" />

        <TextView
            style="@style/SecurityPasswordLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/security_password_group_gap"
            android:labelFor="@id/security_password_repeat"
            android:text="@string/security_password_repeat" />

        <cc.huoyan.opensource.morningcheck.SecurityPasswordEditText
            android:id="@+id/security_password_repeat"
            style="@style/SecurityPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/security_password_input_height"
            android:layout_marginTop="@dimen/security_password_field_gap"
            android:hint="@string/security_password_repeat_hint" />
    </LinearLayout>
</LinearLayout>
