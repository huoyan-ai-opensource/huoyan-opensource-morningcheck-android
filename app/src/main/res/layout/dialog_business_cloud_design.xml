<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cloud_address_panel"
    style="@style/PenPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/PenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/mc_home_design_cloud" />

    <TextView
        style="@style/PenCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/ui_dialog_business_cloud_design_label_text" />

    <EditText
        android:id="@+id/settings_cloud_url"
        style="@style/PenInput"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/dp_4"
        android:hint="https://cloud.example.com"
        android:inputType="textUri" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="@dimen/dp_8">

        <TextView
            android:id="@+id/cloud_address_cancel"
            style="@style/PenButton"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:text="@string/ui_activity_staff_editor_dialog_staff_edit_cancel_text" />

        <TextView
            android:id="@+id/settings_save_cloud"
            style="@style/PenPrimary"
            android:layout_width="@dimen/dp_0"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_weight="1"
            android:text="@string/ui_activity_staff_editor_dialog_staff_edit_save_text" />
    </LinearLayout>
</LinearLayout>
