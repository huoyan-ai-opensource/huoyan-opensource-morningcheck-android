<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_8"
        android:background="@drawable/mc_segment_background"
        android:minHeight="@dimen/dp_24"
        android:padding="@dimen/dp_2">

        <TextView
            android:id="@+id/settings_sdk_local"
            style="@style/PenSegment"
            android:layout_width="@dimen/dp_80"
            android:text="本机" />

        <TextView
            android:id="@+id/settings_sdk_lan"
            style="@style/PenSegment"
            android:layout_width="@dimen/dp_80"
            android:text="局域网" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settings_sdk_local_panel"
        style="@style/PenPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settings_sdk_transport"
            style="@style/PenText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="本机 SDK" />

        <TextView
            android:id="@+id/settings_connection"
            style="@style/PenText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/settings_sdk_mode_hint"
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="使用此设备上的 SDK 服务，无需填写 IP 地址。" />

        <TextView
            android:id="@+id/settings_open_sdk"
            style="@style/PenButton"
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="安装 SDK"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settings_sdk_lan_panel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <include
            layout="@layout/view_sdk_lan_content"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_12"
            android:layout_weight="1" />

        <include layout="@layout/view_sdk_actions" />
    </LinearLayout>
</LinearLayout>
