<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/check_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/mc_white"
    android:gravity="center_vertical"
    android:minHeight="@dimen/dp_44"
    android:orientation="horizontal"
    android:paddingStart="@dimen/dp_12"
    android:paddingTop="@dimen/dp_8"
    android:paddingEnd="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_8">

    <LinearLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/header_shop"
            style="@style/PenText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            tools:text="安和食堂 · 后厨" />

        <TextClock
            android:id="@+id/check_clock"
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:format12Hour="yyyy-MM-dd  HH:mm:ss"
            android:format24Hour="yyyy-MM-dd  HH:mm:ss"
            android:textSize="@dimen/sp_7" />
    </LinearLayout>

    <TextView
        android:id="@+id/header_page_title"
        style="@style/PenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8"
        android:text="@string/ui_view_check_header_header_page_title_text" />

    <Space
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1" />
</LinearLayout>
