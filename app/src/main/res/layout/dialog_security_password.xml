<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/security_password_scrim"
    android:padding="@dimen/security_password_outer_padding"
    android:saveEnabled="false">

    <LinearLayout
        android:id="@+id/security_password_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/security_password_card"
        android:orientation="vertical"
        android:padding="@dimen/security_password_card_padding">

        <TextView
            android:id="@+id/security_password_title"
            style="@style/SecurityPasswordTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/security_password_change_title" />

        <TextView
            android:id="@+id/security_password_description"
            style="@style/SecurityPasswordDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/security_password_small_gap"
            android:text="@string/security_password_change_description" />

        <ScrollView
            android:id="@+id/security_password_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/security_password_section_gap"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:id="@+id/security_password_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/security_password_form"
                    layout="@layout/view_security_password_fields"
                    android:layout_width="@dimen/security_password_zero"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/security_password_keypad"
                    layout="@layout/view_security_password_keypad"
                    android:layout_width="@dimen/security_password_zero"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/security_password_column_gap"
                    android:layout_weight="1" />
            </LinearLayout>
        </ScrollView>

        <include layout="@layout/view_security_password_actions" />
    </LinearLayout>
</FrameLayout>
