<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/result_evidence"
    style="@style/PenPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/result_findings_title"
        style="@style/PenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_view_result_design_photos_result_findings_title_text" />

    <ScrollView
        android:id="@+id/result_findings_scroll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="@dimen/dp_4">

        <TextView
            android:id="@+id/result_findings"
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/result_evidence_title"
            style="@style/PenTitle"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_activity_record_design_record_detail_tab_photos_text" />

        <TextView
            android:id="@+id/result_evidence_caption"
            style="@style/PenCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/result_evidence_grid"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_weight="1"
        android:nestedScrollingEnabled="false"
        android:scrollbars="horizontal|vertical" />
</LinearLayout>
