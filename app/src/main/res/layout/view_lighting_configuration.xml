<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PenPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/lighting_serial_fields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_4"
            android:text="@string/ui_view_lighting_configuration_label_text" />

        <TextView
            android:id="@+id/lighting_path"
            style="@style/PenInput"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/dp_10"
            android:clickable="true"
            android:drawableEnd="@drawable/mc_chevron_right"
            android:drawablePadding="@dimen/dp_6"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/PenCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_4"
                    android:text="@string/ui_view_lighting_configuration_label_text_2" />

                <TextView
                    android:id="@+id/lighting_baud"
                    style="@style/PenInput"
                    android:layout_width="match_parent"
                    android:clickable="true"
                    android:drawableEnd="@drawable/mc_chevron_right"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/PenCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_4"
                    android:text="@string/lighting_command_format" />

                <TextView
                    android:id="@+id/lighting_command_format"
                    style="@style/PenInput"
                    android:layout_width="match_parent"
                    android:clickable="true"
                    android:drawableEnd="@drawable/mc_chevron_right"
                    android:focusable="true"
                    android:text="@string/lighting_format_character" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_4"
            android:text="@string/ui_view_lighting_configuration_label_text_3" />

        <EditText
            android:id="@+id/lighting_on_command"
            style="@style/PenInput"
            android:layout_width="match_parent"
            android:drawableEnd="@drawable/mc_edit"
            android:drawablePadding="@dimen/dp_6"
            android:hint="@string/lighting_character_hint"
            android:inputType="textNoSuggestions" />

        <TextView
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginBottom="@dimen/dp_4"
            android:text="@string/ui_view_lighting_configuration_label_text_4" />

        <EditText
            android:id="@+id/lighting_off_command"
            style="@style/PenInput"
            android:layout_width="match_parent"
            android:drawableEnd="@drawable/mc_edit"
            android:drawablePadding="@dimen/dp_6"
            android:hint="@string/lighting_character_hint"
            android:inputType="textNoSuggestions" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lighting_gpio_fields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_4"
            android:text="@string/ui_view_lighting_configuration_label_text_5" />

        <EditText
            android:id="@+id/lighting_gpio"
            style="@style/PenInput"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/dp_10"
            android:drawableEnd="@drawable/mc_edit"
            android:drawablePadding="@dimen/dp_6"
            android:inputType="textNoSuggestions" />

        <TextView
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_4"
            android:text="@string/ui_view_lighting_configuration_label_text_6" />

        <EditText
            android:id="@+id/lighting_on_level"
            style="@style/PenInput"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/dp_10"
            android:inputType="number" />

        <TextView
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_4"
            android:text="@string/ui_view_lighting_configuration_label_text_7" />

        <EditText
            android:id="@+id/lighting_off_level"
            style="@style/PenInput"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/dp_10"
            android:inputType="number" />

        <TextView
            android:id="@+id/lighting_gpio_map"
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lighting_gpio_mapping" />
    </LinearLayout>
</LinearLayout>
