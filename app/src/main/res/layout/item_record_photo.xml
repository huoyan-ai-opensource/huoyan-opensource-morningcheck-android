<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mc_result_photo_background"
    android:orientation="vertical">

    <cc.huoyan.opensource.morningcheck.RecordPhotoFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/record_photo_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/business_photo_description"
            android:padding="@dimen/dp_2"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/record_photo_empty"
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="3"
            android:padding="@dimen/dp_6" />
    </cc.huoyan.opensource.morningcheck.RecordPhotoFrameLayout>

    <TextView
        android:id="@+id/record_photo_label"
        style="@style/PenCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:minHeight="@dimen/dp_24"
        android:paddingStart="@dimen/dp_4"
        android:paddingTop="@dimen/dp_4"
        android:paddingEnd="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_4" />
</LinearLayout>
