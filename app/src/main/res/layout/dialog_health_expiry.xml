<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/health_date_panel"
    style="@style/McHealthDatePanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:theme="@style/AppPreviewTheme">

    <include
        layout="@layout/view_health_date_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        layout="@layout/view_health_date_calendar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1" />

    <include
        layout="@layout/view_health_date_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
