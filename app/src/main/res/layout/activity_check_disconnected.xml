<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg"
    android:orientation="vertical">

    <include layout="@layout/view_check_header" />

    <LinearLayout
        android:id="@+id/page_content"
        style="@style/PenPage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            style="@style/PenPanel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:importantForAccessibility="no"
                android:src="@drawable/mc_disconnected" />

            <TextView
                style="@style/PenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/ui_activity_check_disconnected_label_text" />

            <TextView
                style="@style/PenCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:gravity="center"
                android:text="@string/ui_activity_check_disconnected_label_text_2" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:visibility="gone">

                <TextView
                    android:id="@+id/check_disconnected_home"
                    style="@style/PenButton"
                    android:layout_width="wrap_content"
                    android:text="@string/department_back" />

                <TextView
                    android:id="@+id/check_disconnected_settings"
                    style="@style/PenPrimary"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:text="@string/ui_activity_check_disconnected_check_disconnected_settings_text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/PenFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical">

            <TextView
                android:id="@+id/check_exit"
                style="@style/PenButton"
                android:layout_width="wrap_content"
                android:text="@string/security_check_exit" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
