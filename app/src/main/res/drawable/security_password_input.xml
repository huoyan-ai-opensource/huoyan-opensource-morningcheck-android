<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/security_password_field_focus" />
            <stroke android:width="@dimen/dp_1" android:color="@color/security_password_primary" />
            <corners android:radius="@dimen/dp_5" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/security_password_field_focus" />
            <stroke android:width="@dimen/dp_1" android:color="@color/security_password_primary" />
            <corners android:radius="@dimen/dp_5" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/security_password_field" />
            <stroke android:width="@dimen/dp_0_5" android:color="@color/security_password_border" />
            <corners android:radius="@dimen/dp_5" />
        </shape>
    </item>
</selector>
