<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/security_password_field_focus" />
            <stroke
                android:width="@dimen/security_password_focus_border_width"
                android:color="@color/security_password_primary" />
            <corners android:radius="@dimen/security_password_control_radius" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/security_password_field_focus" />
            <stroke
                android:width="@dimen/security_password_focus_border_width"
                android:color="@color/security_password_primary" />
            <corners android:radius="@dimen/security_password_control_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/security_password_field" />
            <stroke
                android:width="@dimen/security_password_border_width"
                android:color="@color/security_password_border" />
            <corners android:radius="@dimen/security_password_control_radius" />
        </shape>
    </item>
</selector>
