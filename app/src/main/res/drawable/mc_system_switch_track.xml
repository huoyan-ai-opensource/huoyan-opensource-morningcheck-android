<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#3F3EED" />
            <corners android:radius="@dimen/mc_system_voice_switch_height" />
            <size
                android:width="@dimen/mc_system_voice_switch_width"
                android:height="@dimen/mc_system_voice_switch_height" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CBD2DF" />
            <corners android:radius="@dimen/mc_system_voice_switch_height" />
            <size
                android:width="@dimen/mc_system_voice_switch_width"
                android:height="@dimen/mc_system_voice_switch_height" />
        </shape>
    </item>
</selector>
