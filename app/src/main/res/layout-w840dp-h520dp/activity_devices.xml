<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg"
    android:orientation="vertical"
    tools:context=".DevicesActivity"
    tools:theme="@style/AppPreviewTheme">

    <include layout="@layout/view_app_header" />

    <LinearLayout
        android:id="@+id/page_content"
        style="@style/McBusinessPage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/settings_body"
            style="@style/McSettingsPanel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:layout_weight="1"
            tools:layout="@layout/view_sdk_design" />
    </LinearLayout>
</LinearLayout>
