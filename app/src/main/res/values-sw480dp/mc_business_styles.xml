<?xml version='1.0' encoding='utf-8'?>
<resources>
    <!-- 五档角色样式直接引用 openSource 原有 dimen，补偿最小宽度缩放；不改变系统字体缩放。 -->
    <style name="McBusinessPage" parent="">
        <item name="android:paddingStart">@dimen/dp_12</item>
        <item name="android:paddingEnd">@dimen/dp_12</item>
        <item name="android:paddingTop">@dimen/dp_8</item>
        <item name="android:paddingBottom">@dimen/dp_8</item>
    </style>

    <style name="McBusinessPanel" parent="McPanel">
        <item name="android:padding">@dimen/dp_9</item>
    </style>

    <style name="McBusinessInput" parent="McInput">
        <item name="android:textSize">?attr/mcTextBodySize</item>
        <item name="android:layout_height">@dimen/dp_36</item>
    </style>

    <style name="McBusinessControlRow" parent="">
        <item name="android:layout_height">@dimen/dp_36</item>
    </style>

    <style name="McSettingsLabel" parent="McLabel">
        <item name="android:textSize">?attr/mcTextBodySize</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/dp_18</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="McSettingsHint" parent="McLabel">
        <item name="android:textSize">?attr/mcTextCaptionSize</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/dp_21</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="McSettingsInput" parent="McInput">
        <item name="android:textSize">?attr/mcTextBodySize</item>
        <item name="android:layout_height">@dimen/dp_36</item>
    </style>

    <style name="McSettingsButton" parent="McButton">
        <item name="android:textSize">?attr/mcTextBodySize</item>
        <item name="android:layout_height">@dimen/dp_36</item>
    </style>

    <style name="McSettingsButtonPrimary" parent="McSettingsButton">
        <item name="android:background">@drawable/mc_button_primary</item>
        <item name="android:textColor">@color/mc_white</item>
    </style>

    <style name="McSettingsPanel" parent="McPanel">
        <item name="android:padding">@dimen/dp_9</item>
    </style>

    <style name="McSdkDetails" parent="McText">
        <item name="android:textSize">?attr/mcTextCaptionSize</item>
        <item name="android:paddingStart">@dimen/dp_12</item>
        <item name="android:paddingEnd">@dimen/dp_12</item>
        <item name="android:paddingTop">@dimen/dp_8</item>
        <item name="android:paddingBottom">@dimen/dp_6</item>
        <item name="android:lineSpacingExtra">@dimen/dp_2</item>
    </style>

    <style name="McLoginPanel" parent="">
        <item name="android:padding">@dimen/dp_12</item>
    </style>

    <style name="McLoginTitle" parent="McText">
        <item name="android:textSize">?attr/mcTextTitleSize</item>
    </style>

    <style name="McLoginHint" parent="McLabel">
        <item name="android:textSize">?attr/mcTextCaptionSize</item>
    </style>

    <style name="McLoginProgress" parent="">
        <item name="android:layout_width">@dimen/dp_18</item>
        <item name="android:layout_height">@dimen/dp_18</item>
    </style>

    <style name="LoginAction" parent="">
        <item name="android:minHeight">@dimen/dp_36</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/dp_8</item>
        <item name="android:paddingEnd">@dimen/dp_8</item>
        <item name="android:textSize">?attr/mcTextBodySize</item>
        <item name="android:textColor">#3F3EED</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="McBusinessSpinnerValue" parent="McSpinnerValue">
        <item name="android:minHeight">@dimen/dp_36</item>
        <item name="android:paddingStart">@dimen/dp_6</item>
        <item name="android:paddingEnd">@dimen/dp_6</item>
        <item name="android:paddingTop">@dimen/dp_3</item>
        <item name="android:paddingBottom">@dimen/dp_3</item>
    </style>

    <style name="McBusinessSpinnerOption" parent="McSpinnerOption">
        <item name="android:minHeight">@dimen/dp_36</item>
        <item name="android:paddingStart">@dimen/dp_6</item>
        <item name="android:paddingEnd">@dimen/dp_6</item>
        <item name="android:paddingTop">@dimen/dp_3</item>
        <item name="android:paddingBottom">@dimen/dp_3</item>
    </style>
</resources>
