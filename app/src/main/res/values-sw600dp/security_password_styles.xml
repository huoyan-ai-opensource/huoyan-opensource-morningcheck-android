<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SecurityPasswordTitle" parent="android:Widget.TextView">
        <item name="android:textColor">@color/security_password_text</item>
        <item name="android:textSize">@dimen/sp_12</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SecurityPasswordDescription" parent="android:Widget.TextView">
        <item name="android:textColor">@color/security_password_secondary</item>
        <item name="android:textSize">@dimen/sp_7_5</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SecurityPasswordLabel" parent="android:Widget.TextView">
        <item name="android:textColor">@color/security_password_text</item>
        <item name="android:textSize">@dimen/sp_7_5</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SecurityPasswordInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/security_password_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/dp_8</item>
        <item name="android:paddingEnd">@dimen/dp_8</item>
        <item name="android:paddingTop">@dimen/dp_0</item>
        <item name="android:paddingBottom">@dimen/dp_0</item>
        <item name="android:textColor">@color/security_password_text</item>
        <item name="android:textColorHint">@color/security_password_hint</item>
        <item name="android:textSize">@dimen/sp_9</item>
        <item name="android:inputType">numberPassword</item>
        <item name="android:imeOptions">flagNoPersonalizedLearning|flagNoExtractUi</item>
        <item name="android:maxLength">32</item>
        <item name="android:singleLine">true</item>
        <item name="android:saveEnabled">false</item>
    </style>

    <style name="SecurityPasswordKeyRow.Spaced">
        <item name="android:layout_marginTop">@dimen/dp_4</item>
    </style>

    <style name="SecurityPasswordKey" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">@dimen/dp_0</item>
        <item name="android:layout_height">@dimen/dp_26</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/security_password_key</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minWidth">@dimen/dp_0</item>
        <item name="android:minHeight">@dimen/dp_24</item>
        <item name="android:padding">@dimen/dp_0</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/security_password_text</item>
        <item name="android:textSize">@dimen/sp_11</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SecurityPasswordKey.Middle">
        <item name="android:layout_marginStart">@dimen/dp_4</item>
        <item name="android:layout_marginEnd">@dimen/dp_4</item>
    </style>

    <style name="SecurityPasswordKey.Action">
        <item name="android:textColor">@color/security_password_primary</item>
        <item name="android:textSize">@dimen/sp_8</item>
    </style>

    <style name="SecurityPasswordButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/security_password_key</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minWidth">@dimen/dp_0</item>
        <item name="android:minHeight">@dimen/dp_26</item>
        <item name="android:paddingStart">@dimen/dp_3</item>
        <item name="android:paddingEnd">@dimen/dp_3</item>
        <item name="android:paddingTop">@dimen/dp_5</item>
        <item name="android:paddingBottom">@dimen/dp_5</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/security_password_primary</item>
        <item name="android:textSize">@dimen/sp_9</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
