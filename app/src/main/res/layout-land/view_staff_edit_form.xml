<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/staff_edit_field_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/staff_edit_previous_field"
            style="@style/McStaffFormButton"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:text="@string/ui_view_staff_edit_design_form_staff_edit_previous_field_text" />

        <TextView
            android:id="@+id/staff_edit_field_position"
            style="@style/McStaffFormLabel"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:text="1 / 4" />

        <TextView
            android:id="@+id/staff_edit_next_field"
            style="@style/McStaffFormButton"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:text="@string/ui_view_staff_edit_design_form_staff_edit_next_field_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/staff_edit_group_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_6"
        android:orientation="vertical">

        <TextView
            style="@style/McStaffFormLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ui_view_staff_edit_form_label_text" />

        <EditText
            android:id="@+id/staff_edit_name"
            style="@style/McStaffFormInput"
            android:layout_width="match_parent"
            android:hint="@string/ui_view_staff_edit_design_form_staff_edit_name_hint"
            android:imeOptions="actionNext|flagNoExtractUi|flagNoFullscreen"
            android:inputType="textPersonName"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/staff_edit_group_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_6"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/McStaffFormLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ui_view_staff_edit_form_label_text_2" />

        <EditText
            android:id="@+id/staff_edit_number"
            style="@style/McStaffFormInput"
            android:layout_width="match_parent"
            android:hint="@string/ui_view_staff_edit_design_form_staff_edit_number_hint"
            android:imeOptions="actionNext|flagNoExtractUi|flagNoFullscreen"
            android:inputType="text"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/staff_edit_group_department"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_6"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/McStaffFormLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ui_view_staff_edit_form_label_text_3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/staff_edit_department_value"
                style="@style/McStaffFormInput"
                android:layout_width="@dimen/dp_0"
                android:layout_weight="1"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/ui_view_staff_edit_design_form_staff_edit_department_value_text" />

            <TextView
                android:id="@+id/staff_edit_clear_department"
                style="@style/McStaffFormButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/dp_4"
                android:contentDescription="@string/ui_view_departments_design_department_clear_text"
                android:text="@string/activation_code_clear" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/staff_edit_group_health"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_6"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/McStaffFormLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ui_view_staff_edit_form_label_text_4" />

        <TextView
            android:id="@+id/staff_edit_health"
            style="@style/McStaffFormInput"
            android:layout_width="match_parent"
            android:clickable="true"
            android:contentDescription="@string/ui_view_staff_edit_design_form_staff_edit_health_contentdescription"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/ui_view_staff_edit_design_form_staff_edit_health_text" />
    </LinearLayout>
</LinearLayout>
