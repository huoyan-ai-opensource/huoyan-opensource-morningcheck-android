<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/mc_white"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_12"
    android:paddingEnd="@dimen/dp_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/header_leading"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/header_brand"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/dp_18"
                    android:layout_height="@dimen/dp_18"
                    android:contentDescription="火眼晨检"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    style="@style/PenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_11"
                    android:text="火眼晨检" />

                <TextView
                    android:id="@+id/header_workspace"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/header_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    android:id="@+id/header_back_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="@dimen/dp_0_5"
            android:layout_height="@dimen/dp_20"
            android:layout_marginStart="@dimen/dp_12"
            android:background="#DFE4ED" />

        <LinearLayout
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/dp_12">

            <TextView
                android:id="@+id/header_shop"
                style="@style/PenText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold" />

            <TextClock
                style="@style/PenCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:format12Hour="yyyy-MM-dd EEEE  HH:mm:ss"
                android:format24Hour="yyyy-MM-dd EEEE  HH:mm:ss"
                android:textSize="@dimen/sp_7" />
        </LinearLayout>

        <TextView
            android:id="@+id/header_page_title"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/header_trailing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/home_cloud_pending"
            style="@style/PenCaption"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_26"
            android:background="@drawable/mc_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/dp_8"
            android:paddingEnd="@dimen/dp_8"
            android:text="○ 云端服务"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_settings"
            style="@style/PenButton"
            android:layout_width="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:text="关于设备"
            android:textSize="@dimen/sp_8" />
    </LinearLayout>

</LinearLayout>
