<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg"
    android:orientation="vertical">

    <include layout="@layout/view_app_header" />

    <LinearLayout
        android:id="@+id/page_content"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/dp_0">

        <LinearLayout
            android:id="@+id/result_body"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:layout_margin="@dimen/dp_12"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include
                layout="@layout/view_result_design_summary"
                android:layout_width="@dimen/dp_200"
                android:layout_height="match_parent" />

            <include
                layout="@layout/view_result_design_photos"
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            style="@style/PenFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/result_flow_state"
                style="@style/PenCaption"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/result_stay"
                style="@style/PenButton"
                android:layout_width="wrap_content"
                android:text="停留查看" />

            <TextView
                android:id="@+id/result_next"
                style="@style/PenPrimary"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/dp_6"
                android:text="下一位" />

            <TextView
                android:id="@+id/result_exit"
                style="@style/PenButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/dp_6"
                android:text="@string/security_check_exit" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
