<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ChoiceDialogPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mc_panel"
    android:orientation="vertical">

    <TextView
        style="@style/FontChoiceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:minHeight="@dimen/dp_13"
        android:text="@string/app_font_size_dialog_title" />

    <LinearLayout
        style="@style/ChoiceContent"
        android:id="@+id/settings_font_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include
            layout="@layout/view_font_size_dialog_preview"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ListView
            style="@style/FontChoiceList"
            android:id="@+id/settings_font_options"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:choiceMode="singleChoice"
            android:divider="@android:color/transparent"
            android:scrollbars="vertical" />
    </LinearLayout>

    <include
        layout="@layout/view_font_size_dialog_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4" />
</LinearLayout>
