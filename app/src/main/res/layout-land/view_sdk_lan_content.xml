<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/settings_sdk_address_panel"
        style="@style/PenPanel"
        android:layout_width="@dimen/dp_180"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            style="@style/PenText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_view_sdk_lan_content_label_text" />

        <EditText
            android:id="@+id/settings_sdk_url"
            style="@style/PenInput"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/dp_6"
            android:hint="192.168.1.100"
            android:inputType="textNoSuggestions"
            android:maxLength="15" />

        <TextView
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/ui_view_sdk_lan_content_label_text_2" />
    </LinearLayout>

    <LinearLayout
        style="@style/PenPanel"
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settings_sdk_discovery_title"
            style="@style/PenText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_view_sdk_lan_content_settings_sdk_discovery_title_text" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:layout_weight="1">

            <ListView
                android:id="@+id/settings_sdk_discovery_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="@dimen/dp_4" />

            <TextView
                android:id="@+id/settings_sdk_discovery_empty"
                style="@style/PenCaption"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/ui_view_sdk_lan_content_settings_sdk_discovery_empty_text" />
        </FrameLayout>

        <TextView
            style="@style/PenCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/ui_view_sdk_lan_content_label_text_3" />
    </LinearLayout>
</LinearLayout>
