<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_hero_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mc_home_design_hero"
    android:orientation="vertical"
    android:padding="@dimen/dp_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:importantForAccessibility="no"
            android:src="@drawable/mc_home_face"
            app:tint="@color/mc_white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:orientation="vertical">

            <TextView
                style="@style/PenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_view_home_design_hero_label_text"
                android:textColor="@color/mc_white"
                android:textSize="@dimen/sp_16" />

            <TextView
                android:id="@+id/home_hero_detail"
                style="@style/PenText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/ui_view_home_design_hero_home_hero_detail_text"
                android:textColor="@color/mc_white" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/home_start"
        style="@style/PenButton"
        android:layout_width="match_parent"
        android:text="@string/ui_view_home_design_hero_home_start_text" />
</LinearLayout>
