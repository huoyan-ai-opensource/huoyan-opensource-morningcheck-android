<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 翻页、页码输入和跳转共用触控高度，窄屏操作组保持紧凑。 -->
    <style name="McPaginationControlBase" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/mc_pagination_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="McPaginationControl" parent="McPaginationControlBase">
        <item name="android:layout_height">@dimen/dp_48</item>
        <item name="android:minHeight">@dimen/dp_48</item>
        <item name="android:layout_marginStart">@dimen/dp_2</item>
    </style>

    <style name="McPaginationIconButtonBase" parent="McPaginationControl">
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="McPaginationIconButton" parent="McPaginationIconButtonBase">
        <item name="android:layout_width">@dimen/dp_44</item>
        <item name="android:padding">@dimen/dp_12</item>
    </style>

    <style name="McPaginationJumpButtonBase" parent="McPaginationControl">
        <item name="android:textSize">?attr/mcTextBodySize</item>
        <item name="fontFamily">?attr/mcFontBold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/mc_blue</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="McPaginationJumpButton" parent="McPaginationJumpButtonBase">
        <item name="android:minWidth">@dimen/dp_60</item>
        <item name="android:paddingStart">@dimen/dp_6</item>
        <item name="android:paddingEnd">@dimen/dp_6</item>
    </style>

    <style name="McPaginationPageInputBase" parent="McPaginationControl">
        <item name="android:textSize">?attr/mcTextBodySize</item>
        <item name="fontFamily">?attr/mcFontRegular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:background">@drawable/mc_pagination_input</item>
        <item name="android:textColor">@color/mc_ink</item>
        <item name="android:inputType">number</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLength">10</item>
        <item name="android:imeOptions">actionGo</item>
        <item name="android:paddingTop">@dimen/dp_0</item>
        <item name="android:paddingBottom">@dimen/dp_0</item>
        <item name="android:selectAllOnFocus">true</item>
    </style>

    <style name="McPaginationPageInput" parent="McPaginationPageInputBase">
        <item name="android:layout_width">@dimen/dp_50</item>
        <item name="android:paddingStart">@dimen/dp_4</item>
        <item name="android:paddingEnd">@dimen/dp_4</item>
    </style>

    <style name="McPaginationInfo" parent="McLabel">
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:minHeight">@dimen/dp_0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingTop">@dimen/dp_2</item>
        <item name="android:paddingBottom">@dimen/dp_2</item>
    </style>
</resources>
