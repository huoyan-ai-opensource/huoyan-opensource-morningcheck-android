<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SecurityPasswordTitle" parent="android:Widget.TextView">
        <item name="android:textColor">@color/security_password_text</item>
        <item name="android:textSize">@dimen/security_password_title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SecurityPasswordDescription" parent="android:Widget.TextView">
        <item name="android:textColor">@color/security_password_secondary</item>
        <item name="android:textSize">@dimen/security_password_description_size</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SecurityPasswordLabel" parent="android:Widget.TextView">
        <item name="android:textColor">@color/security_password_text</item>
        <item name="android:textSize">@dimen/security_password_label_size</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SecurityPasswordInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/security_password_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/security_password_control_padding</item>
        <item name="android:paddingEnd">@dimen/security_password_control_padding</item>
        <item name="android:paddingTop">@dimen/security_password_zero</item>
        <item name="android:paddingBottom">@dimen/security_password_zero</item>
        <item name="android:textColor">@color/security_password_text</item>
        <item name="android:textColorHint">@color/security_password_hint</item>
        <item name="android:textSize">@dimen/security_password_input_size</item>
        <item name="android:inputType">numberPassword</item>
        <item name="android:imeOptions">flagNoPersonalizedLearning|flagNoExtractUi</item>
        <item name="android:maxLength">32</item>
        <item name="android:singleLine">true</item>
        <item name="android:saveEnabled">false</item>
    </style>

    <style name="SecurityPasswordKeyRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <style name="SecurityPasswordKeyRow.Spaced">
        <item name="android:layout_marginTop">@dimen/security_password_key_gap</item>
    </style>

    <style name="SecurityPasswordKey" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">@dimen/security_password_zero</item>
        <item name="android:layout_height">@dimen/security_password_key_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/security_password_key</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minWidth">@dimen/security_password_zero</item>
        <item name="android:minHeight">@dimen/security_password_touch_min_height</item>
        <item name="android:padding">@dimen/security_password_zero</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/security_password_text</item>
        <item name="android:textSize">@dimen/security_password_key_size</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SecurityPasswordKey.Middle">
        <item name="android:layout_marginStart">@dimen/security_password_key_gap</item>
        <item name="android:layout_marginEnd">@dimen/security_password_key_gap</item>
    </style>

    <style name="SecurityPasswordKey.Action">
        <item name="android:textColor">@color/security_password_primary</item>
        <item name="android:textSize">@dimen/security_password_action_size</item>
    </style>

    <style name="SecurityPasswordButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/security_password_key</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minWidth">@dimen/security_password_zero</item>
        <item name="android:minHeight">@dimen/security_password_input_height</item>
        <item name="android:paddingStart">@dimen/security_password_small_gap</item>
        <item name="android:paddingEnd">@dimen/security_password_small_gap</item>
        <item name="android:paddingTop">@dimen/security_password_control_vertical_padding</item>
        <item name="android:paddingBottom">@dimen/security_password_control_vertical_padding</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/security_password_primary</item>
        <item name="android:textSize">@dimen/security_password_button_size</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SecurityPasswordButton.Primary">
        <item name="android:background">@drawable/security_password_primary</item>
        <item name="android:textColor">@color/security_password_surface</item>
    </style>
</resources>
