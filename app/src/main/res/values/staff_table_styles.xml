<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 表头与数据列共用相同留白；姓名靠左，其余列居中。 -->
    <style name="McStaffListCell" parent="PenRowCell">
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:paddingStart">@dimen/dp_2</item>
        <item name="android:paddingEnd">@dimen/dp_2</item>
    </style>

    <style name="McStaffListNumberCell" parent="PenText">
        <item name="android:layout_width">@dimen/dp_0</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:paddingStart">@dimen/dp_2</item>
        <item name="android:paddingEnd">@dimen/dp_2</item>
    </style>

    <style name="McStaffListHeaderCell" parent="PenHeaderCell">
        <item name="android:textAlignment">gravity</item>
        <item name="android:paddingStart">@dimen/dp_2</item>
        <item name="android:paddingEnd">@dimen/dp_2</item>
    </style>
    <!-- 表头与数据行共用边距；五档样式引用原尺寸表，补偿最小宽度缩放。 -->
</resources>
